# Copy this file to secrets.yaml and fill in your own values.
# secrets.yaml is git-ignored, so your passwords never get committed.
wifi_ssid: "YourWiFiName"
wifi_password: "YourWiFiPassword"
fallback_ap_password: "change-me-123"
# Encrypts the Home Assistant API and OTA updates for every device
api_encryption_key: "REPLACE_ME"  # generate with: openssl rand -base64 32
# Smart lock keypad code (4-8 digits)
door_pin: "change-me"
